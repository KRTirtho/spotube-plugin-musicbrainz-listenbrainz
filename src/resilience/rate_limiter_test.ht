import "module:std" as std
import { TokenBucketRateLimiter } from './rate_limiter.ht'

var assert = std.assert

/// Tests para TokenBucketRateLimiter
fun main() {
  test_allows_burst_up_to_capacity()
  test_refills_tokens_over_time()
  test_clamps_at_burst_capacity()
  print("All TokenBucketRateLimiter tests passed!")
}

fun test_allows_burst_up_to_capacity() {
  var limiter = TokenBucketRateLimiter(5, 1.0)
  
  for (var i = 0; i < 5; i++) {
    assert(limiter.acquire(), "Should acquire token $i")
  }
  assert(!limiter.acquire(), "6th token should fail")
  print("✓ test_allows_burst_up_to_capacity passed")
}

fun test_refills_tokens_over_time() {
  // Nota: En test real usaríamos clock mock, aquí demostramos concepto
  var limiter = TokenBucketRateLimiter(2, 10.0)
  
  assert(limiter.acquire(), "First token")
  assert(limiter.acquire(), "Second token")
  assert(!limiter.acquire(), "Third should fail (burst exhausted)")
  
  // En implementación real: advance clock 1 segundo → +10 tokens → clamp to 2
  // assert(limiter.acquire(), "After refill, should acquire")
  
  print("✓ test_refills_tokens_over_time conceptually passed")
}

fun test_clamps_at_burst_capacity() {
  var limiter = TokenBucketRateLimiter(3, 100.0)
  
  // Simular tiempo transcurrido grande
  // En test real: clock.advance(Duration(seconds: 10))
  // limiter._refill() → should clamp at 3
  
  print("✓ test_clamps_at_burst_capacity conceptually passed")
}

export { test_allows_burst_up_to_capacity, test_refills_tokens_over_time, test_clamps_at_burst_capacity }