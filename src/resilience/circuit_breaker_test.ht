import "module:std" as std
import { CircuitBreaker, CircuitBreakerConfig, CircuitState, ErrorKind } from './circuit_breaker.ht'

var assert = std.assert

/// Tests para CircuitBreaker
fun main() {
  test_opens_after_threshold_failures()
  test_enters_half_open_after_recovery_timeout()
  test_closes_after_successful_half_open_probes()
  print("All CircuitBreaker tests passed!")
}

fun test_opens_after_threshold_failures() {
  var cb = CircuitBreaker(CircuitBreakerConfig(failureThreshold: 3))
  
  cb.recordFailure(ErrorKind.SERVICE_UNAVAILABLE)
  cb.recordFailure(ErrorKind.SERVICE_UNAVAILABLE)
  assert(cb.state == CircuitState.CLOSED, "Should be closed after 2 failures")
  assert(cb.canProceed(), "Should allow proceed after 2 failures")
  
  cb.recordFailure(ErrorKind.SERVICE_UNAVAILABLE)  // 3er fallo
  assert(cb.state == CircuitState.OPEN, "Should be open after 3 failures")
  assert(!cb.canProceed(), "Should block when open")
  
  print("✓ test_opens_after_threshold_failures passed")
}

fun test_enters_half_open_after_recovery_timeout() {
  // Nota: En test real usaríamos TestClock, aquí demostramos concepto
  var cb = CircuitBreaker(CircuitBreakerConfig(
    failureThreshold: 2, 
    recoveryTimeout: Duration(seconds: 10)
  ))
  
  cb.recordFailure(ErrorKind.SERVICE_UNAVAILABLE)
  cb.recordFailure(ErrorKind.SERVICE_UNAVAILABLE)
  assert(cb.state == CircuitState.OPEN, "Should be open")
  
  // En test real: clock.advance(11.seconds)
  // cb._updateStateFromTime() → should enter HALF_OPEN
  // assert(cb.state == CircuitState.HALF_OPEN, "Should be half-open after timeout")
  // assert(cb.canProceed(), "Should allow probes in half-open")
  
  print("✓ test_enters_half_open_after_recovery_timeout conceptually passed")
}

fun test_closes_after_successful_half_open_probes() {
  var cb = CircuitBreaker(CircuitBreakerConfig(
    failureThreshold: 2, 
    recoveryTimeout: Duration(seconds: 10),
    halfOpenMaxAttempts: 2
  ))
  
  cb.recordFailure(ErrorKind.SERVICE_UNAVAILABLE)
  cb.recordFailure(ErrorKind.SERVICE_UNAVAILABLE)
  // clock.advance(11.seconds) → HALF_OPEN
  
  cb.recordSuccess()  // 1
  assert(cb.state == CircuitState.HALF_OPEN, "Should remain half-open after 1 success")
  
  cb.recordSuccess()  // 2 → close
  assert(cb.state == CircuitState.CLOSED, "Should close after 2 half-open successes")
  assert(cb.canProceed(), "Should allow proceed when closed")
  
  print("✓ test_closes_after_successful_half_open_probes passed")
}

export { test_opens_after_threshold_failures, test_enters_half_open_after_recovery_timeout, test_closes_after_successful_half_open_probes }