import "module:std" as std
import "module:spotube_plugin" as spotube
import { EmulatedArtistAlbum } from "../common/album-artist.ht"
import { CommonArtistEntity } from "../common/artist.ht"
import { MbConverter, LbConverter } from "./converter.ht"


var HttpClient = std.HttpClient
var HttpResponse = std.HttpResponse
var RequestOptions = std.RequestOptions
var LocalStorage = spotube.LocalStorage

class ArtistEndpoint {
  var lbApi: HttpClient
  var mbApi: HttpClient
  final username: string

  var emulator: EmulatedArtistAlbum

  var artistCommon: CommonArtistEntity

  construct (this.lbApi, this.mbApi, this.username) {
    this.emulator = EmulatedArtistAlbum(lbApi, mbApi, username)
    this.artistCommon = CommonArtistEntity(lbApi, mbApi, username)
  }

  fun getArtist(id: string) {
    return mbApi.get_req(
      "/artist/${id}",
      queryParameters: {
        fmt: "json",
        inc: "url-rels"
      }.toJson()
    ).then((res){
      var data = res.data

      var wikiId = data["relations"].firstWhere(
        (relation) => relation["type"] == "wikidata",
        orElse: () => null
      )?["url"]?["resource"]?.split("/")?.last

      return artistCommon.getMultipleArtistImages([wikiId]).then((imagesMap){
        var images = imagesMap[wikiId] ?? []
        var artist = MbConverter.artists([data]).first
        artist["images"] = images
        return artist
      })
    })
  }

  fun topTracks(id: string, {limit: int, offset: int}) {
    var topLimit = limit ?? 50
    if (topLimit > 50) {
      topLimit = 50
    }

    return lbApi.get_req(
      "/popularity/top-recordings-for-artist/${id}",
    ).then((res){
      var data = res.data ?? []
      var recordingMbids = data
        .take(topLimit)
        .map((recording) => recording["recording_mbid"])
        .where((recordingMbid) => recordingMbid != null)
        .toList()

      if (recordingMbids.isEmpty) {
        return {
          limit: topLimit,
          nextOffset: null,
          total: 0,
          hasMore: false,
          items: []
        }.toJson()
      }

      var recordingBatches = []
      for (var i = 0; i < recordingMbids.length; i += 10) {
        recordingBatches.add(recordingMbids.skip(i).take(10).toList())
      }

      return Future.wait(
        recordingBatches.map((batch) {
          return mbApi.get_req(
            "/recording",
            queryParameters: {
              fmt: "json",
              query: batch.map((recordingMbid) => "rid:${recordingMbid}").join(" OR "),
              limit: batch.length,
              inc: "artist-credits+releases+release-groups+isrcs"
            }.toJson()
          ).then((res) {
            return MbConverter.recordings(res.data["recordings"] ?? [])
          })
        }).toList()
      ).then((recordingGroups){
        var recordingsById = {}

        for (var recordings in recordingGroups) {
          for (var recording in recordings) {
            recordingsById[recording["id"]] = recording
          }
        }

        var items = recordingMbids
          .where((recordingMbid) => recordingsById.containsKey(recordingMbid))
          .map((recordingMbid) => recordingsById[recordingMbid])
          .toList()

        return {
          limit: topLimit,
          nextOffset: null,
          total: recordingMbids.length,
          hasMore: false,
          items: items
        }.toJson()
      })
    })
  }

  fun albums(id: string, {offset: int, limit: int}) {
    return mbApi.get_req(
      "/release-group",
      queryParameters: {
        fmt: "json",
        artist: id,
        type: "album|ep",
        "release-group-status": "website-default",
        limit: limit ?? 20,
        offset: offset ?? 0,
        inc: "artist-credits"
      }.toJson()
    ).then((res){
      var data = res.data

      var items = MbConverter.releaseGroups(data["release-groups"])
      var hasMore = data["release-groups"].length >= (limit ?? 20)

      return {
        limit: limit ?? 20,
        nextOffset: hasMore ? data["release-group-offset"] + (limit ?? 20) : null,
        total: data["release-group-count"],
        hasMore: hasMore,
        items: items
      }.toJson()
    })
  }

  fun save(artistIds: List) {
    return emulator.save("artist", artistIds)
  }

  fun unsave(artistIds: List) {
    assert(artistIds.isNotEmpty)
    
    return emulator.unsave("artist", artistIds)
  }

  fun related(artistId: string, {limit: int, offset: int}) {
    return lbApi.get_req(
      "/lb-radio/artist/${artistId}",
      queryParameters: {
        mode: "medium",
        max_similar_artists: limit ?? 20,
        max_recordings_per_artist: 1,
        pop_begin: 20,
        pop_end: 100,
      }.toJson()
    ).then((res) {
      var artistIds = res.data.keys
      return artistCommon.listArtists(artistIds).then((artists){
        var items = MbConverter.artists(artists)
        
        return {
          limit: limit ?? 20,
          nextOffset: null,
          total: artistIds.length,
          hasMore: false,
          items: items
        }.toJson()
      })
    })
  }
}

export { ArtistEndpoint }
