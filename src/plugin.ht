import "module:std" as std

import { AuthEndpoint } from './segments/auth.ht'
import { AlbumEndpoint } from "./segments/album.ht"
import { ArtistEndpoint } from "./segments/artist.ht"
import { BrowseEndpoint } from "./segments/browse.ht"
import { PlaylistEndpoint } from './segments/playlist.ht'
import { SearchEndpoint } from './segments/search.ht'
import { TrackEndpoint } from './segments/track.ht'
import { UserEndpoint } from './segments/user.ht'
import { CorePlugin } from './segments/core.ht'
import { TokenBucketRateLimiter, musicbrainzRateLimiter } from './resilience/rate_limiter.ht'
import { CircuitBreaker, musicbrainzCircuitBreaker, listenbrainzCircuitBreaker, ErrorKind } from './resilience/circuit_breaker.ht'
import { ErrorClassifier } from './resilience/error_classifier.ht'
import { retry, RetryConfig } from './resilience/retry.ht'

var Stream = std.Stream
var HttpClient = std.HttpClient
var HttpBaseOptions = std.HttpBaseOptions

class BrainzMetadataProviderPlugin {
  var auth: AuthEndpoint
  var album: AlbumEndpoint
  var artist: ArtistEndpoint
  var browse: BrowseEndpoint
  var playlist: PlaylistEndpoint
  var search: SearchEndpoint
  var track: TrackEndpoint
  var user: UserEndpoint
  var core: CorePlugin

  var lbApi: HttpClient
  var mbApi: HttpClient

  construct (){
    mbApi = HttpClient(
      HttpBaseOptions(
        baseUrl: "https://musicbrainz.org/ws/2"
      )
    )
    lbApi = HttpClient(
      HttpBaseOptions(
        baseUrl: "https://api.listenbrainz.org/1",
      )
    )

    auth = AuthEndpoint(lbApi, mbApi)
    core = CorePlugin(mbApi, lbApi)

    setAccessToken()
    auth.authStateStream.listen((event) {
      setAccessToken()
    })
  }

  fun setAccessToken() {
    mbApi = HttpClient(
      HttpBaseOptions(
        baseUrl: auth.credentials?["mb_url"] ?? "https://musicbrainz.org/ws/2",
      )
    )
    lbApi = HttpClient(
      HttpBaseOptions(
        baseUrl: auth.credentials?["lb_url"] ?? "https://api.listenbrainz.org/1",
        headers: auth.credentials == null ? null : {
          "Authorization": "Token ${auth.credentials['token']}"
        }.toJson()
      )
    )

    var username = auth.credentials == null ? null : auth.credentials['username']

    album = AlbumEndpoint(lbApi, mbApi, username)
    artist = ArtistEndpoint(lbApi, mbApi, username)
    browse = BrowseEndpoint(lbApi, mbApi, username)
    playlist = PlaylistEndpoint(lbApi, mbApi, username)
    search = SearchEndpoint(lbApi, mbApi, username)
    track = TrackEndpoint(lbApi, mbApi, username)
    user = UserEndpoint(lbApi, mbApi, username)
    core = CorePlugin(mbApi, lbApi, this)  // Pasar referencia al plugin para lbResilient
  }

  /// Wrapper con resiliencia para llamadas a MusicBrainz
  fun mbResilient(fn: () -> Future) -> Future {
    // Rate limiting
    if (!musicbrainzRateLimiter.canAcquire()) {
      // Esperar hasta que haya token disponible
      var waitTime = Duration(milliseconds: ((1.0 - musicbrainzRateLimiter.availableTokens) / 8.0 * 1000).toInt())
      return Future.delayed(waitTime).then((_) => mbResilient(fn))
    }
    musicbrainzRateLimiter.acquire()

    // Circuit breaker
    if (!musicbrainzCircuitBreaker.canProceed()) {
      throw std.Exception("MusicBrainz circuit breaker is OPEN")
    }

    // Retry con backoff exponencial + jitter
    return retry(
      fn,
      maxAttempts: 3,
      initialDelay: Duration(milliseconds: 400),
      multiplier: 2.0,
      maxDelay: Duration(seconds: 10),
      onRetry: (attempt, error, delay) {
        print("MusicBrainz retry attempt $attempt after error: $error, waiting ${delay.inMilliseconds}ms")
      }
    ).then((result) {
      musicbrainzCircuitBreaker.recordSuccess()
      return result
    }).catchError((error) {
      var errorKind = ErrorClassifier.classify(error)
      musicbrainzCircuitBreaker.recordFailure(errorKind)
      throw error
    })
  }

  /// Wrapper con resiliencia para llamadas a ListenBrainz
  fun lbResilient(fn: () -> Future) -> Future {
    // Circuit breaker
    if (!listenbrainzCircuitBreaker.canProceed()) {
      throw std.Exception("ListenBrainz circuit breaker is OPEN")
    }

    return retry(
      fn,
      maxAttempts: 3,
      initialDelay: Duration(milliseconds: 400),
      multiplier: 2.0,
      maxDelay: Duration(seconds: 10),
      onRetry: (attempt, error, delay) {
        print("ListenBrainz retry attempt $attempt after error: $error, waiting ${delay.inMilliseconds}ms")
      }
    ).then((result) {
      listenbrainzCircuitBreaker.recordSuccess()
      return result
    }).catchError((error) {
      var errorKind = ErrorClassifier.classify(error)
      listenbrainzCircuitBreaker.recordFailure(errorKind)
      throw error
    })
  }
}

export { BrainzMetadataProviderPlugin }